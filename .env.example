# ===== Koyun Chat 配置（复制成 .env 后填写）=====

# 访客挂件和接口的公开地址（生成嵌入代码时使用），例如 https://chatapi.example.com
KC_API_URL=

# 端口映射：默认只给本机的 Nginx / Caddy 反向代理用
KC_BIND=127.0.0.1
KC_PORT=8790

# 时区
TZ=Asia/Shanghai

# 使用自带 Caddy（docker compose --profile caddy up -d）时填写两个域名
KC_CONSOLE_DOMAIN=chat.example.com
KC_API_DOMAIN=chatapi.example.com

# 自己构建镜像时可改名，例如 KC_IMAGE=koyunchat:local 再 docker compose build
# KC_IMAGE=ghcr.io/xiaofujie369/koyunchat:latest
