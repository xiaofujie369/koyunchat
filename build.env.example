# 复制成 build.env 后填写（build.env 不会上传仓库）
BUILD_HOST=root@编译机IP            # 编译机（需要装好 Go）
BUILD_DIR=/opt/koyunchat-build      # 编译机上的工作目录
BUILD_GO_ENV=                       # 可选：编译前要 source 的环境脚本，例如 /opt/go/env.sh
BUILD_PASSWORD_FILE=                # 可选：用密码登录时，存密码的文件（留空 = 用 SSH 密钥）
BUILD_PASSWORD_KEY=编译机密码        # 密码文件里那一行的开头文字
DEPLOY_HOST=root@线上服务器IP        # 线上服务器（建议用 ~/.ssh/config 里的别名）
DEPLOY_DIR=/opt/koyunchat           # 线上程序目录
